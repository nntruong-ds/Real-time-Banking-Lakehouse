# Sao chép file này thành .env rồi điền giá trị thật. File .env KHÔNG đưa lên GitHub.
# Tạo nhanh bằng lệnh:   echo "PII_HMAC_KEY=$(openssl rand -hex 32)" > .env

# Khóa bí mật để băm số thẻ bằng HMAC-SHA256 ở tầng Silver (tối thiểu 32 ký tự).
# Đổi khóa = toàn bộ card_token đổi theo, nên giữ cố định sau khi đã chạy.
PII_HMAC_KEY=
